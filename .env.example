OPENAI_API_KEY=<the openai api key>

POSTGRES_USER=<the database username>
POSTGRES_PASSWORD=<the database password>
POSTGRES_DB=<the database name>
POSTGRES_PORT=<the database port>
DATABASE_URL=<the database url>
DATABASE_READONLY_URL=<read-only connection string for the Database Agent — see learnings.md #5>
DATABASE_READONLY_PASSWORD=<strong password used to create the read-only database role>

# Supabase Auth. Public signup stays disabled; provision employees in the Supabase dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... key from Supabase API settings>

# Bound each external dependency during web startup. An unavailable dependency degrades its
# agent instead of preventing the API and /health endpoint from starting.
STARTUP_DEPENDENCY_TIMEOUT_SECONDS=15

ATLASSIAN_EMAIL=<the email you signed up with>
ATLASSIAN_API_TOKEN=<the token from step above>
ATLASSIAN_SITE_URL=<your site, e.g. https://abc.atlassian.net>
ATLASSIAN_MCP_TOKEN=<scoped API token with Teamwork Graph read:jira-platform + read:confluence scopes>

BITBUCKET_USERNAME=<your bitbucket username>
BITBUCKET_APP_PASSWORD=<the app password>
BITBUCKET_WORKSPACE=alderbrook-systems

SYNTHETIC_EMPLOYEE_BASE_EMAIL=<the gmail address the +alias employee accounts were created from>

# Communication Agent (Component 6) — see learnings.md #6
SLACK_BOT_TOKEN=<Bot User OAuth Token from api.slack.com/apps, starts with xoxb->
SLACK_TEST_CHANNEL_ID=<Slack channel ID to post test messages to, e.g. C0123456789>

# Sends via Resend's HTTP API (learnings.md #12 follow-up), not raw SMTP — SMTP connections hung
# indefinitely on Render (outbound SMTP is restricted/dropped on many PaaS hosts), so this was
# switched to a plain HTTPS call, same as SlackClient. Get an API key at resend.com; EMAIL_FROM_ADDRESS
# must be an address on a domain you've verified with Resend (or their sandbox sender while testing).
RESEND_API_KEY=<API key from resend.com>
EMAIL_FROM_ADDRESS=<a verified-domain address to send as, e.g. agent@yourdomain.com>
EMAIL_TEST_RECIPIENT=<the address test/demo emails should actually be sent to>

# Web API / login uses the Supabase Auth settings above.

# Origin the FastAPI backend accepts CORS requests from — the deployed Vercel URL in production,
# http://localhost:3000 (the default if unset) for local Next.js dev.
FRONTEND_ORIGIN=http://localhost:3000

# scripts/smoke_test_api.py only — a real provisioned Supabase Auth login.
SMOKE_TEST_EMAIL=<email of a provisioned Supabase Auth user>
SMOKE_TEST_PASSWORD=<that user's real plaintext password>
# Defaults to http://localhost:8000 if unset; point at the deployed Render URL to smoke-test that
# instead, e.g. https://nexusai-api-ctud.onrender.com
SMOKE_TEST_BASE_URL=http://localhost:8000
# Unset by default — the script only stages-then-cancels a Communication Agent draft so it never
# spams Slack/email on every run. Set to 1 to also exercise one real confirm -> real send.
SMOKE_TEST_CONFIRM_SEND=0
